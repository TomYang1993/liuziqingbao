---
import data from '../../data/perm.json';
const fmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const SITE = 'https://liuzi.win/perm';
const VOTES_URL = import.meta.env.PUBLIC_VOTES_URL ?? '';
const DESC = 'PERM green card sponsorship tier list: which big tech employers are still filing, which paused. Community-reported. 各大公司 PERM 绿卡 sponsor 现状梯队.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PERM · 北美留子今天还活着</title>
    <meta name="description" content={DESC} />
    <link rel="canonical" href={SITE} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="PERM · who is still filing green cards" />
    <meta property="og:description" content={DESC} />
    <meta property="og:url" content={SITE} />
    <meta property="og:image" content="https://liuzi.win/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/msz-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/nserif-tiers.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: 'Tier Serif'; src: url('/nserif-tiers.woff2') format('woff2'); font-weight: 900; font-display: swap; }
      @font-face { font-family: 'Ma Shan Zheng'; src: url('/msz-subset.woff2') format('woff2'); font-display: swap; unicode-range: U+5317, U+7F8E, U+7559, U+5B50, U+4ECA, U+5929, U+8FD8, U+6D3B, U+7740, U+592F, U+4EBA, U+4E0A, U+62C9, U+5B8C, U+4E86, U+68AF, U+961F, U+0041-005A, U+0028-0029; }
      :root {
        --bg: #fbfaf7; --fg: #1a1a1a; --muted: #6b6b6b; --line: #e6e2d8; --accent: #b3261e; --chip: #efece4; --card: #ffffff;
        --sponsoring: #1f6f3f; --paused: #8a6d00; --not_sponsoring: #b3261e; --stuck: #1f4f8a;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #141414; --fg: #eae8e3; --muted: #9a9a9a; --line: #2a2a2a; --accent: #ff6b5e; --chip: #232323; --card: #1c1c1c;
          --sponsoring: #5fbf7f; --paused: #e0b63a; --not_sponsoring: #ff6b5e; --stuck: #6fa3e0; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.55 ui-serif, Georgia, "Noto Serif SC", serif; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
      .sans { font-family: ui-sans-serif, system-ui, sans-serif; }
      .intro a { color: inherit; }
      .crumb { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.8rem; color: var(--muted); margin-bottom: 1rem; }
      .crumb a { color: inherit; text-decoration: none; }
      .crumb a:hover { text-decoration: underline; }
      .crumb .brand { font-family: 'Ma Shan Zheng', 'Noto Serif SC', serif; font-size: 1.1rem; color: var(--fg); }
      h1 { font-size: 2rem; margin: 0; letter-spacing: -0.02em; }
      h1 small { display: block; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.8rem; font-weight: 400; color: var(--muted); letter-spacing: 0.04em; margin-top: 0.3rem; }
      .intro { color: var(--muted); margin: 0.9rem 0 0; max-width: 720px; }
      .tiers { display: grid; gap: 0.6rem; margin-top: 2rem; }
      .tier { display: grid; grid-template-columns: 156px 1fr; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--card); }
      @media (max-width: 560px) { .tier { grid-template-columns: 96px 1fr; } }
      .tier .lab { display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 1rem 0.5rem; color: #fff; text-align: center; }
      .tier .lab b { font-family: 'Tier Serif', 'Noto Serif SC', 'Songti SC', serif; font-weight: 900; font-size: 1.5rem; line-height: 1; letter-spacing: 0.01em; }
      .tier.s .lab { background: linear-gradient(135deg, #b3261e, #e0463b); }
      .tier.a .lab { background: linear-gradient(135deg, #b8620a, #e08a2a); }
      .tier.b .lab { background: linear-gradient(135deg, #8a6d00, #c7a21f); }
      .tier.f .lab { background: linear-gradient(135deg, #4a4a4a, #7a7a7a); }
      .tier .co { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; padding: 0.9rem 1rem; }
      .tier .co .logo { display: inline-flex; width: 52px; height: 52px; align-items: center; justify-content: center; border-radius: 10px; background: #fff; border: 1px solid var(--line); cursor: default; transition: transform 0.15s; }
      .tier .co .logo:hover { transform: translateY(-2px); }
      .tier .co .logo img { width: 36px; height: 36px; object-fit: contain; border-radius: 6px; }
      .tier.f .co .logo { filter: grayscale(1); opacity: 0.55; }
      .tier.f .co .logo:hover { filter: none; opacity: 1; }
      .tier .co .none { color: var(--muted); font-weight: 400; background: none; border: 0; }
      .report { margin-top: 2.5rem; padding: 1.4rem 1.25rem; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
      .report h2 { margin: 0 0 0.4rem; font-size: 1.15rem; }
      .report p { margin: 0 0 1rem; font-size: 0.9rem; color: var(--muted); }
      .report form { display: grid; gap: 0.75rem; max-width: 640px; }
      .report .row { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
      .report label { display: grid; gap: 0.3rem; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.78rem; font-weight: 600; color: var(--muted); flex: 1 1 200px; }
      .report input, .report select, .report textarea { font: inherit; font-size: 0.95rem; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 0.5rem 0.6rem; width: 100%; }
      .report textarea { resize: vertical; font-family: ui-serif, Georgia, serif; }
      .report button { font-family: ui-sans-serif, system-ui, sans-serif; font-weight: 600; padding: 0.45rem 1.1rem; border: 1px solid var(--fg); background: var(--fg); color: var(--bg); border-radius: 999px; cursor: pointer; }
      .report .msg { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); }
      footer { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; font-family: ui-sans-serif, system-ui, sans-serif; }
      footer a { color: inherit; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="crumb"><a href="/" class="brand">北美留子今天还活着</a> &nbsp;/&nbsp; PERM</div>
      <h1>PERM<small>Who is still filing green cards · updated {fmt(data.updated)}</small></h1>
      <p class="intro">Community-reported. Policy shifts fast and varies by org and level; treat this as the vibe, not a promise. Know a change? Feedback box on the <a href="/">home page</a>.</p>

      <div class="tiers">
        {data.tiers.map((t) => (
          <section class={`tier ${t.id}`}>
            <div class="lab"><b>{t.label}</b></div>
            <div class="co">
              {t.companies.length
                ? t.companies.map((c) => (
                    <span class="logo" title={c.note ? `${c.name}: ${c.note}` : c.name} aria-label={c.name}>
                      <img src={`/logos/${c.logo ?? c.domain.replace(/\.com$/, '') + '.png'}`} alt={c.name} width="36" height="36" loading="lazy" />
                    </span>
                  ))
                : <span class="none">Nobody yet</span>}
            </div>
          </section>
        ))}
      </div>

      <section class="report">
        <h2>Report a company</h2>
        <p>Org-level details matter: "company sponsors but our org froze," "files but every case gets audited," "PERM approved but takes 18 months." Put that in the note. A link (小红书 / Blind / email screenshot) helps.</p>
        <form id="pr">
          <div class="row">
            <label>Company <input name="company" required maxlength="80" placeholder="e.g. Meta" /></label>
            <label>Tier
              <select name="tier" required>
                <option value="">Pick one</option>
                {data.tiers.map((t) => <option value={t.id}>{t.label}</option>)}
                <option value="unknown">Not sure</option>
              </select>
            </label>
          </div>
          <label>What you know <textarea name="note" required maxlength="2000" rows="4" placeholder="Which org / level, since when, filing or not, audit or approval outcome, timeline..."></textarea></label>
          <label>Link (optional) <input name="link" type="url" maxlength="500" placeholder="https://" /></label>
          <div class="row"><button type="submit">Send</button><span class="msg" aria-live="polite"></span></div>
        </form>
      </section>

      <footer>
        Not legal advice. Community-reported; verify with your own immigration team.
      </footer>
    </div>
    <script define:vars={{ VOTES_URL }}>
      document.getElementById('pr')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target, msg = f.querySelector('.msg'), btn = f.querySelector('button');
        btn.disabled = true;
        try {
          const r = await fetch(`${VOTES_URL}/perm-report`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ company: f.company.value, tier: f.tier.value, note: f.note.value, link: f.link.value }) });
          msg.textContent = r.ok ? 'Sent. Thanks, reviewed monthly.' : r.status === 429 ? 'Too many. Try later.' : 'Failed. Try again.';
          if (r.ok) f.reset();
        } catch { msg.textContent = 'Failed. Try again.'; }
        btn.disabled = false;
      });
    </script>
  </body>
</html>
