---
import issues from '../../../data/issues.json';
import items from '../../../data/items.json';

export function getStaticPaths() {
  return issues.map((iss) => ({ params: { id: iss.id }, props: { iss } }));
}
const { iss } = Astro.props;
const fmt = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const updated = iss.timeline.at(-1)?.date ?? '2026-09-14';
const first = iss.timeline[0]?.date ?? updated;
const related = items
  .filter((i) => i.relevant !== false && (i.topics ?? []).some((t) => iss.topics.includes(t)))
  .slice(0, 8);
const SITE = 'https://liuzi.win';
const url = `${SITE}/issues/${iss.id}`;
const title = `${iss.title} · ${iss.status}`;
const desc = iss.summary.length > 155 ? iss.summary.slice(0, 152).replace(/\s+\S*$/, '') + '…' : iss.summary;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 北美留子今天还活着</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="北美留子今天还活着" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="article:published_time" content={first} />
    <meta property="article:modified_time" content={updated} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/msz-subset.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: iss.title,
      description: desc,
      datePublished: first,
      dateModified: updated,
      url,
      author: { '@type': 'Organization', name: '北美留子今天还活着', url: SITE },
      publisher: { '@type': 'Organization', name: '北美留子今天还活着', url: SITE },
      about: iss.topics,
      citation: iss.timeline.filter((e) => e.url).map((e) => e.url),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '北美留子今天还活着', item: SITE + '/' },
        { '@type': 'ListItem', position: 2, name: iss.title, item: url },
      ],
    })} />
    <style is:global>
      @font-face { font-family: 'Ma Shan Zheng'; src: url('/msz-subset.woff2') format('woff2'); font-display: swap; unicode-range: U+5317, U+7F8E, U+7559, U+5B50, U+4ECA, U+5929, U+8FD8, U+6D3B, U+7740; }
      :root { --bg: #fbfaf7; --fg: #1a1a1a; --muted: #6b6b6b; --line: #e6e2d8; --accent: #b3261e; --chip: #efece4; --card: #ffffff; color-scheme: light dark; }
      @media (prefers-color-scheme: dark) { :root { --bg: #141414; --fg: #eae8e3; --muted: #9a9a9a; --line: #2a2a2a; --accent: #ff6b5e; --chip: #232323; --card: #1c1c1c; } }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 ui-serif, Georgia, "Noto Serif SC", serif; }
      .wrap { max-width: 760px; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
      .crumb { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.8rem; color: var(--muted); margin-bottom: 1.2rem; }
      .crumb a { color: inherit; text-decoration: none; }
      .crumb a:hover { text-decoration: underline; }
      .crumb .brand { font-family: 'Ma Shan Zheng', 'Noto Serif SC', serif; font-size: 1.1rem; color: var(--fg); }
      h1 { font-size: 2rem; line-height: 1.2; margin: 0 0 0.6rem; letter-spacing: -0.02em; }
      .status { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent); display: inline-flex; align-items: center; gap: 0.4rem; }
      .status::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
      .meta { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.78rem; color: var(--muted); margin: 0.4rem 0 1.6rem; display: flex; gap: 0.7rem; flex-wrap: wrap; }
      .chips span { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.72rem; background: var(--chip); padding: 0.15rem 0.55rem; border-radius: 4px; margin-right: 0.3rem; }
      .summary { font-size: 1.08rem; margin: 0 0 1.4rem; }
      .links { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.8rem; }
      .linkbtn { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.78rem; font-weight: 600; text-decoration: none; color: var(--bg); background: var(--fg); border-radius: 999px; padding: 0.35rem 0.85rem; }
      .linkbtn:hover { background: var(--accent); }
      h2 { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 2rem 0 0.9rem; }
      .tl { list-style: none; margin: 0; padding: 0 0 0 1rem; border-left: 2px solid var(--line); }
      .tl li { position: relative; padding: 0 0 1rem 1rem; font-size: 0.95rem; }
      .tl li::before { content: ''; position: absolute; left: calc(-1rem - 5px); top: 0.5em; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
      .tl li:last-child::before { background: var(--fg); }
      .tl time { display: block; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.72rem; color: var(--muted); }
      .tl a { color: inherit; }
      .tl .note { display: block; font-size: 0.74rem; color: var(--muted); font-family: ui-sans-serif, system-ui, sans-serif; }
      article { padding: 1rem 0; border-top: 1px solid var(--line); }
      article .m { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.75rem; color: var(--muted); display: flex; gap: 0.6rem; margin-bottom: 0.25rem; }
      article h3 { font-size: 1rem; margin: 0 0 0.3rem; line-height: 1.35; }
      article h3 a { color: inherit; text-decoration: none; }
      article h3 a:hover { text-decoration: underline; }
      article p { margin: 0; font-size: 0.9rem; color: var(--fg); }
      footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.82rem; font-family: ui-sans-serif, system-ui, sans-serif; }
      footer a { color: inherit; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="crumb"><a href="/" class="brand">北美留子今天还活着</a> &nbsp;/&nbsp; <a href="/#tracking">Tracking</a> &nbsp;/&nbsp; {iss.title}</div>
      <h1>{iss.title}</h1>
      <span class="status">{iss.status}</span>
      <div class="meta">
        <span>Updated {fmt(updated)}</span>
        <span class="chips">{iss.topics.map((t) => <span>{t}</span>)}</span>
      </div>
      <p class="summary">{iss.summary}</p>
      {iss.links?.length > 0 && (
        <div class="links">{iss.links.map((l) => <a class="linkbtn" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</div>
      )}

      <h2>Timeline</h2>
      <ol class="tl">
        {iss.timeline.map((e) => (
          <li>
            <time datetime={e.date}>{fmt(e.date)}</time>
            {e.url ? <a href={e.url} target="_blank" rel="noopener">{e.label}</a> : e.label}
            {e.note && <span class="note">{e.note}</span>}
          </li>
        ))}
      </ol>

      {related.length > 0 && (
        <>
          <h2>Related official updates</h2>
          {related.map((i) => (
            <article>
              <div class="m"><span>{i.source}</span><span>{fmt(i.published)}</span></div>
              <h3><a href={i.url} target="_blank" rel="noopener">{i.title}</a></h3>
              {i.summary && <p>{i.summary}</p>}
            </article>
          ))}
        </>
      )}

      <footer>
        Not legal advice. Every entry links to its official source. <a href="/">← All tracking issues and latest updates</a>
      </footer>
    </div>
  </body>
</html>
